# =============================================================================
# DX-TwinOS Environment Configuration Template (.env.example)
# Sao chép file này thành `.env` trước khi chạy `make up`:
#   cp .env.example .env
# =============================================================================

# --- Global Workspace Settings ---
DXOS_ENV=development
DXOS_VERSION=0.1.0
DXOS_DOMAIN=localhost

# --- 1. Traefik API Gateway (Tier 1 Zero-Trust Entrypoint) ---
TRAEFIK_HTTP_PORT=8000
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_DYNAMIC_CONFIG_DIR=/etc/traefik/dynamic

# --- 2. Keycloak Unified Identity & SSO (Tier 1 IAM - Apache-2.0) ---
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=dxos_secret_2026
KC_REALM_NAME=dx-twinos
KC_HTTP_RELATIVE_PATH=/auth
KC_JWKS_URI=http://identity-keycloak:8080/auth/realms/dx-twinos/protocol/openid-connect/certs
KC_ISSUER_URI=http://localhost:8000/auth/realms/dx-twinos
KC_CLIENT_WORKSPACE_UI=dxos-workspace-ui
KC_CLIENT_AGENT_BRAIN=dxos-agent-brain
KC_CLIENT_AGENT_SECRET=change_me_agent_service_secret_2026

# --- 3A. PostgreSQL 16 (Tier 1 Structured SSOT & Data Lineage Ledger) ---
POSTGRES_HOST=data-postgres
POSTGRES_PORT=5432
POSTGRES_DB=dxos_ssot
POSTGRES_USER=dxos_user
POSTGRES_PASSWORD=dxos_pass_2026
DATABASE_URL=postgresql://dxos_user:dxos_pass_2026@data-postgres:5432/dxos_ssot

# --- 3B. RustFS Object Storage (Tier 1 Unstructured S3 P.A.R.A - Apache-2.0) ---
RUSTFS_HOST=data-rustfs
RUSTFS_PORT=9000
RUSTFS_ENDPOINT_URL=http://data-rustfs:9000
RUSTFS_ACCESS_KEY=dxos_s3_key
RUSTFS_SECRET_KEY=dxos_s3_secret_2026
RUSTFS_DEFAULT_BUCKET=dxos-para-vault
RUSTFS_REGION=ap-southeast-1

# --- 4. Kestra Declarative Workflow Engine (Tier 1 Headless Orchestrator - Apache-2.0) ---
KESTRA_HOST=workflow-kestra
KESTRA_PORT=8080
KESTRA_API_URL=http://workflow-kestra:8080/api/v1
KESTRA_NAMESPACE=dxos.supplychain

# --- 5. Ollama Local LLM & Agentic Brain (Tier 2 Intelligence Layer) ---
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL_PRIMARY=qwen2.5:7b-instruct
OLLAMA_MODEL_VISION=llava:7b
AGENT_BRAIN_HOST=0.0.0.0
AGENT_BRAIN_PORT=8080
AGENT_CONFIDENCE_THRESHOLD=0.90
AGENT_REQUIRE_HUMAN_IN_THE_LOOP=true
